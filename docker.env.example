# =============================================================================
# DOCKER COMPOSE profile — copy this to `.env` at the project root.
#
#   cp .env.example .env      (identical to `cp docker.env.example .env`)
#
# Used by `docker compose up`: values here feed BOTH docker-compose.yml's
# ${VAR} substitutions (ports, container/volume names) AND the whatsapp-api
# container's process.env (via `env_file: .env`).
#
# For running the API outside Docker, see local.env.example and
# debug.local.example instead — see README.md § "Running Modes" for details.
# =============================================================================

# ── Authentication ───────────────────────────────────────────────────────────
# API_TOKEN is the primary authentication mechanism (sent as X-Api-Token header).
# BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD provide an alternative Basic Auth
# scheme (sent as Authorization: Basic <base64> header) — used by the PWA.
API_TOKEN=change_me_to_a_random_string_at_least_8_chars
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=whatsapp

# ── Instance Configuration ───────────────────────────────────────────────────
# Set INSTANCE_NAME to create separate instances with isolated session data.
# Each instance gets its own volumes, container names, and network namespace.
INSTANCE_NAME=whatsapp-neo

# ── Port Configuration (host-side) ───────────────────────────────────────────
# Customize ports to avoid conflicts when running multiple instances.
NOVNC_PORT=3008
API_PORT=3022
PWA_PORT=3009
# CDP_PORT=9223

# ── Chromium CDP endpoint ─────────────────────────────────────────────────────
# Docker service name — resolved via Docker's internal DNS. Do not change this
# unless you also change the service name in docker-compose.yml.
CHROMIUM_CDP_URL=ws://whatsapp-chromium:9223

# ── Webhook ───────────────────────────────────────────────────────────────────
# HTTP POST destination for incoming WhatsApp messages.
# Leave empty to only log incoming messages to stdout.
WEBHOOK_URL=

# ── Server (container-side) ──────────────────────────────────────────────────
# Must stay 3000 — matches the Dockerfile's EXPOSE and the compose port
# mapping (${API_PORT}:3000) and healthcheck.
PORT=3000
SESSION_DATA_PATH=./.wwebjs_auth

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=UTC

# Phone number used by the Phase 0 verification test script (digits only, no +)
TEST_PHONE=521234567890

# Example for multiple instances:
# Instance 1: INSTANCE_NAME=whatsapp-instance1 NOVNC_PORT=3008 API_PORT=3022 PWA_PORT=3009
# Instance 2: INSTANCE_NAME=whatsapp-instance2 NOVNC_PORT=3010 API_PORT=3023 PWA_PORT=3011
# Instance 3: INSTANCE_NAME=whatsapp-instance3 NOVNC_PORT=3012 API_PORT=3024 PWA_PORT=3013
