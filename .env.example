# Instance Configuration
# Set INSTANCE_NAME to create separate instances with isolated session data
# Each instance will have its own volumes and network namespace
INSTANCE_NAME=whatsapp-neo2

# Port Configuration
# Customize ports to avoid conflicts when running multiple instances
NOVNC_PORT=3008
API_PORT=3022

# Example for multiple instances:
# Instance 1: INSTANCE_NAME=whatsapp-instance1 NOVNC_PORT=3008 API_PORT=3022
# Instance 2: INSTANCE_NAME=whatsapp-instance2 NOVNC_PORT=3009 API_PORT=3023
# Instance 3: INSTANCE_NAME=whatsapp-instance3 NOVNC_PORT=3010 API_PORT=3024
