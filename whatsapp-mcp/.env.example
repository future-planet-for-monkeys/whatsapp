# Base URL of the whatsapp-neo-api server
WHATSAPP_API_BASE_URL=http://localhost:3000

# Authentication — choose one:
# Option A: Bearer token (set API_TOKEN in the API server)
WHATSAPP_API_TOKEN=your-api-token-here

# Option B: HTTP Basic Auth
WHATSAPP_BASIC_AUTH_USERNAME=admin
WHATSAPP_BASIC_AUTH_PASSWORD=whatsapp