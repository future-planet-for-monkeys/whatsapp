		},
		"/single/avatar/{contactId}": {
			"get": {
				"operationId": "GetAvatar",
				"responses": {
					"204": {
						"description": "No content"
					},
					"404": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": [
										"message"
									],
									"type": "object"
								}
							}
						}
					},
					"502": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": [
										"message"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"description": "Serve a contact/chat's avatar as raw, unencrypted image bytes.\n\nWe intentionally never hand the raw WhatsApp CDN URL (pps.whatsapp.net /\nmmg.whatsapp.net, etc.) back to the browser. Those URLs:\n  - are signed and time-limited (`oe`/`oh` query params expire),\n  - are sometimes served with misleading headers\n    (e.g. `Content-Disposition: attachment; filename=file.enc`),\n  - and, for actual message media, are AES-encrypted and require the\n    mediaKey to decrypt.\n\nSince the API container already has an authenticated puppeteer/WhatsApp\nWeb session, we fetch the image server-side here and stream back plain\nimage bytes with a correct Content-Type — the client never talks to\nWhatsApp's CDN directly.",
				"tags": [
					"Single"
				],
				"security": [
					{
						"jwtAuth": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "contactId",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
