# WhatsApp API base URL (used in production build via nginx proxy)
# In development, Vite dev server proxies /api to http://localhost:3022
VITE_API_BASE_URL=/api

# Optional: override Vite dev proxy target (for multi-instance setups)
# Example: VITE_DEV_API_TARGET=http://localhost:3023
VITE_DEV_API_TARGET=http://localhost:3022

# Optional: pre-fill login form for development
# VITE_DEFAULT_USERNAME=
# VITE_DEFAULT_PASSWORD=