# =============================================================================
# LOCAL (hybrid) profile — local API process + dockerized Chromium.
#
# Use this when you want to run whatsapp-api directly with Node (fast
# reload, breakpoints via `node --inspect`, etc.) while still using the
# Chromium + noVNC + CDP-proxy containers for the browser itself.
#
# Setup:
#   1. Start only the browser containers (skip whatsapp-api and whatsapp-pwa):
#        docker compose up -d whatsapp-chromium cdp-proxy
#   2. Copy this file to `local.env` at the project root, then run the API
#      locally, pointing ENV_FILE at it (resolved from the project root,
#      regardless of your current directory):
#        cp local.env.example local.env
#        cd whatsapp-api
#        ENV_FILE=local.env npm run dev
#      (or copy this file to whatsapp-api/.env and just `npm run dev`)
#
# Chromium's CDP port is reached via the port Docker exposes to the host
# (CDP_PORT, default 9223) — NOT the internal Docker DNS name, since the API
# process itself is running outside the Docker network here.
# =============================================================================

# ── Authentication ───────────────────────────────────────────────────────────
API_TOKEN=local-dev-token-change-me
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=whatsapp

# ── Chromium CDP endpoint (host-exposed port from docker-compose) ───────────
CHROMIUM_CDP_URL=ws://127.0.0.1:9223

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_URL=

# ── Server ────────────────────────────────────────────────────────────────────
# Free to pick any port — this process is NOT managed by docker-compose.
PORT=3007

# Session data is stored relative to CWD (whatsapp-api/ when run via
# `npm run dev`) — this is a SEPARATE session from the Docker Compose
# profile's volume-backed one. Scan a fresh QR code the first time.
SESSION_DATA_PATH=./.wwebjs_auth

# ── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=UTC
TEST_PHONE=+16073041892
