// ---------------------------------------------------------------------------
// Prisma schema for whatsapp-neo multi-user state.
//
// Each "user" is a logical person sharing a single WhatsApp Web session.
// The Set<string> fields in the original UserModel are modelled as
// many-to-many join tables keyed on string IDs from the WhatsApp API.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── User ────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  phoneNumber  String   @unique
  passwordHash String
  notes        String?
  createdAt    DateTime @default(now())

  readChats    ReadChat[]
  sentMessages SentMessage[]
  seenMessages SeenMessage[]
}

// ── Chat ────────────────────────────────────────────────────────────────────
model Chat {
  id        String   @id
  createdAt DateTime @default(now())
  chatData  Json // Stores the raw WhatsApp chat data as a JSON object, without messages.

  messageRecords Message[]       // Messages in this chat
  readByUsers    ReadChat[]      // Users who have read this chat
  sentMessages   SentMessage[]   // Sent-message join records
  seenMessages   SeenMessage[]   // Seen-message join records
}

// ── Message ─────────────────────────────────────────────────────────────────
model Message {
  id          String   @id
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageData Json     // Stores the raw WhatsApp message data as a JSON object.
  createdAt   DateTime @default(now())

  sentByUsers SentMessage[] // Join records linking to users who sent this
  seenByUsers SeenMessage[] // Join records linking to users who saw this
}

// ── Per-user read-chat tracking ─────────────────────────────────────────────
// Records which chats a user has read.
model ReadChat {
  userId String
  chatId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
}

// ── Per-user sent-message tracking ───────────────────────────────────────────
// Records which messages were sent by a given user.
// messageId is a WhatsApp message.id._serialised string.
model SentMessage {
  userId    String
  messageId String
  chatId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

// ── Per-user seen-message tracking ───────────────────────────────────────────
// Records which messages a user has seen / opened.
// messageId is a WhatsApp message.id._serialised string.
model SeenMessage {
  userId    String
  messageId String
  chatId    String
  chat      Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}