										},
										"userId": {
											"type": "string"
										}
									},
									"required": [
										"name",
										"userId"
									],
									"type": "object"
								},
								"type": "array"
							},
							"me": {
								"type": "boolean"
							},
							"someone": {
								"type": "boolean"
							}
						},
						"additionalProperties": {},
