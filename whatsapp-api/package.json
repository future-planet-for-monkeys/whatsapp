{
  "name": "whatsapp-neo-api",
  "version": "2.0.0",
  "description": "REST API for WhatsApp via whatsapp-web.js + remote Chromium — rebuilt with tsoa",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "tsoa": "tsoa spec-and-routes",
    "dev": "npm run tsoa && nodemon --watch src --ext ts,json --exec \"npm run tsoa && npx tsx src/server.ts\"",
    "dev:fast": "nodemon --watch src --ext ts,json --ignore src/generated --exec \"npm run tsoa && npx tsx src/server.ts\"",
    "build": "npm run tsoa && tsc --noEmit",
    "start": "npm run tsoa && npx tsx src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.4.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.4",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
