							"users",
							"me",
							"someone"
						],
						"type": "object"
					},
					"timestamp": {
						"type": "number",
						"format": "double",
						"description": "Unix epoch seconds"
					},
					"isEdited": {
						"type": "boolean",
						"description": "Whether the message has been edited (via our app)"
