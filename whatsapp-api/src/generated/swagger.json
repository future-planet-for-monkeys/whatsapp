					"editedBy": {
						"properties": {
							"name": {
								"type": "string"
							},
							"userId": {
								"type": "string"
							}
						},
						"required": [
							"name",
							"userId"
						],
						"type": "object",
						"nullable": true,
						"description": "Who performed the last edit, if any"
					},
					"isDeleted": {
						"type": "boolean",
						"description": "Whether the message has been deleted (via our app)"
					},
					"deletedBy": {
						"properties": {
							"name": {
								"type": "string"
							},
							"userId": {
								"type": "string"
							}
						},
						"required": [
							"name",
							"userId"
						],
						"type": "object",
						"nullable": true,
						"description": "Who performed the deletion, if any"
					},
