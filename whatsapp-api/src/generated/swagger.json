				"type": "object",
				"additionalProperties": false
			},
			"UpdateChatLabelsRequest": {
				"properties": {
					"labelIds": {
						"items": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "number",
									"format": "double"
								}
							]
						},
						"type": "array",
						"description": "Full set of label IDs to assign to the chat (replaces existing labels)"
					}
				},
				"required": [
					"labelIds"
				],
				"type": "object",
				"additionalProperties": false
			},
			"JWTContents": {
				"properties": {
					"userId": {
						"type": "string"
					},
					"name": {
						"type": "string"
					}
				},
				"required": [
					"userId",
					"name"
				],
				"type": "object",
				"additionalProperties": false
			},
			"CreateUserRequest": {
				"properties": {
					"name": {
						"type": "string"
					},
					"password": {
						"type": "string"
					},
					"phoneNumber": {
						"type": "string"
					},
					"notes": {
						"type": "string"
					}
				},
				"required": [
					"name",
					"password",
					"phoneNumber"
				],
				"type": "object",
				"additionalProperties": false
			}
		},
		"securitySchemes": {
			"bearerAuth": {
				"type": "apiKey",
				"in": "header",
				"name": "X-Api-Token",
				"description": "API_TOKEN from .env — set in X-Api-Token request header"
			},
			"basicAuth": {
				"type": "http",
				"scheme": "basic",
				"description": "BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD from .env — standard HTTP Basic Auth"
			},
			"jwtAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "JWT obtained from POST /auth/login or POST /auth/signup — set as Authorization: Bearer <token>"
			}
		}
	},
	"info": {
		"title": "WhatsApp Neo API",
		"version": "2.0.0",
		"description": "REST API for WhatsApp via whatsapp-web.js + remote Chromium CDP.\n\nAuth scheme split by endpoint type:\n- `/auth/*`     → Authorization: Basic <base64> (system credentials, obtain a JWT)\n- `/single/*`   → Authorization: Bearer <JWT>    (per-user state)\n- `/health`     → no auth required\n\nSee the Auth section for how to obtain a JWT via /auth/login or /auth/signup.",
		"contact": {}
	},
	"paths": {
		"/single/chats/list": {
			"get": {
				"operationId": "GetChats",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/ChatDto"
									},
									"type": "array"
								}
							}
						}
					}
				},
				"tags": [
					"Single"
				],
				"security": [
					{
						"jwtAuth": []
					}
				],
				"parameters": [
					{
						"in": "query",
						"name": "limit",
						"required": false,
						"schema": {
							"default": 50,
							"format": "double",
							"type": "number"
						}
					},
					{
						"in": "query",
						"name": "offset",
						"required": false,
						"schema": {
							"default": 0,
							"format": "double",
							"type": "number"
						}
					},
					{
						"in": "query",
						"name": "includeArchived",
						"required": false,
						"schema": {
							"default": false,
							"type": "boolean"
						}
					}
				]
			}
		},
		"/single/chats/{id}": {
			"get": {
				"operationId": "GetChatById",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ChatDto"
								}
							}
						}
					},
					"404": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": [
										"message"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"tags": [
					"Single"
				],
				"security": [
					{
						"jwtAuth": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/single/chats/{id}/read": {
			"post": {
				"operationId": "MarkAsRead",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"success": {
											"type": "boolean"
										}
									},
									"required": [
										"success"
									],
									"type": "object"
								}
							}
						}
					},
					"404": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": [
										"message"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"tags": [
					"Single"
				],
				"security": [
					{
						"jwtAuth": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/single/chats/{id}/messages": {
			"get": {
				"operationId": "GetChatMessages",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/MessageDto"
									},
									"type": "array"
								}
							}
						}
					},
					"400": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"error": {
											"type": "string"
										}
									},
									"required": [
										"error"
									],
									"type": "object"
								}
							}
						}
					},
					"404": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": [
										"message"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"description": "Fetch messages for a specific chat.\nSupports pagination via `limit` and `offset`.\n\n`fetchMessages` returns the most recent N messages, oldest-first.\nPagination counts from the newest end:\n  - offset=0  → the most recent `limit` messages\n  - offset=50 → the next 50 messages going back\n\n0.5: Scrollback is capped at 200 messages total.",
				"tags": [
					"Single"
				],
				"security": [
					{
						"jwtAuth": []
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "limit",
						"required": false,
						"schema": {
							"default": 50,
							"format": "double",
							"type": "number"
						}
					},
					{
						"in": "query",
						"name": "offset",
						"required": false,
						"schema": {
							"default": 0,
							"format": "double",
							"type": "number"
						}
					}
				]
			}
		},
		"/single/messages/{id}/media": {
			"get": {
				"operationId": "DownloadMedia",
				"responses": {
					"204": {
						"description": "No content"
					},
					"400": {
						"description": "",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"error": {
											"type": "string"
										}
									},
									"required": [
										"error"
									],
									"type": "object"
								}
							}
						}
