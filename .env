# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token required on every API request. Change this to a strong random value.
API_TOKEN=change-me-to-a-strong-random-token-at-least-32-chars

# HTTP Basic Auth (Nginx Proxy Manager / reverse-proxy)
# ───────────────────────────────────────────────────────
# If NPM is configured with Basic Auth in front of this service, set the NPM
# Basic Auth PASSWORD to the same value as API_TOKEN above.
# The username can be anything (it is ignored by the app).
# This allows the app to accept both:
#   Authorization: Bearer <API_TOKEN>     (Swagger UI "Authorize" dialog)
#   Authorization: Basic base64(u:TOKEN)  (forwarded by NPM after Basic Auth)

# ── Chromium CDP ──────────────────────────────────────────────────────────────
# WebSocket endpoint of the remote Chromium DevTools Protocol debugger.
# Uses the container name on the internal Docker network.
# Port 9223 is the nginx proxy that re-exposes Chromium's loopback-only CDP
# debugger port (9222) on all interfaces inside the whatsapp-chromium namespace.
CHROMIUM_CDP_URL=ws://whatsapp-neo2-chromium:9223

# ── Webhook ───────────────────────────────────────────────────────────────────
# HTTP POST destination for incoming WhatsApp messages.
# Leave empty to only log incoming messages to stdout.
WEBHOOK_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_DATA_PATH=/app/.wwebjs_auth

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=UTC
