		"securitySchemes": {
			"bearerAuth": {
				"type": "apiKey",
				"in": "header",
				"name": "X-Api-Token",
				"description": "API_TOKEN from .env — set in X-Api-Token request header"
			},
			"basicAuth": {
				"type": "http",
				"scheme": "basic",
				"description": "BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD from .env — standard HTTP Basic Auth"
			},
			"jwtAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "JWT obtained from POST /auth/login or POST /auth/signup — set as Authorization: Bearer <token>"
			}
		}
