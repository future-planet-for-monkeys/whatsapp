				},
				"required": [
					"emoji",
					"count",
					"reactedByMe",
					"users"
				],
				"type": "object",
				"additionalProperties": false
			},
			"MessageDto": {
				"properties": {
					"id": {
						"$ref": "#/components/schemas/MessageIdDto"
