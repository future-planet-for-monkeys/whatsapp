				"required": [
					"archived",
					"id",
					"isGroup",
					"name",
					"chatAvatarUrl",
					"unreadCount",
					"lastMessage",
					"pinned",
					"timestamp"
				],
				"type": "object",
				"additionalProperties": false
			},
			"ClientStatus": {
				"type": "string",
				"enum": [
					"initializing",
					"qr_ready",
					"ready",
					"disconnected",
					"auth_failure"
				]
			},
			"ClientStateResponse": {
				"properties": {
					"waState": {
						"type": "string",
						"description": "Raw WAState value from whatsapp-web.js (e.g. \"CONNECTED\", \"DISCONNECTED\", \"UNPAIRED\")"
					},
					"status": {
						"$ref": "#/components/schemas/ClientStatus",
						"description": "Simplified client status mapped to the API's ClientStatus type"
					},
					"qrAvailable": {
						"type": "boolean",
						"description": "Whether a QR code is available for pairing"
					},
					"qrDataURL": {
						"type": "string",
						"nullable": true,
						"description": "QR code as a PNG data URL (only present when qrAvailable is true)"
					},
					"ready": {
						"type": "boolean",
						"description": "Convenience flag: true when the client is fully connected and ready"
					}
				},
				"required": [
					"waState",
					"status",
					"qrAvailable",
					"qrDataURL",
					"ready"
				],
				"type": "object",
				"additionalProperties": false
			},
			"ContactDto": {
				"properties": {
					"id": {
						"type": "string",
						"description": "WhatsApp serialized ID (e.g. \"1234567890@c.us\")"
					},
					"phoneNumber": {
						"type": "string",
						"nullable": true,
						"description": "Phone number digits (e.g. \"12345678901\"), null if unresolvable (@lid-only)"
					},
					"name": {
						"type": "string",
						"nullable": true,
						"description": "The contact's name as saved by the current user"
					},
					"pushname": {
						"type": "string",
						"nullable": true,
						"description": "The name the contact has configured to be shown publicly"
					},
					"shortName": {
						"type": "string",
						"nullable": true,
						"description": "Shortened version of name"
					},
					"isMyContact": {
						"type": "boolean",
						"description": "Whether this number is saved in the current phone's contacts"
					},
					"isBusiness": {
						"type": "boolean",
						"description": "Whether the contact is a business"
					},
					"isBlocked": {
						"type": "boolean",
						"description": "Whether the contact is blocked"
					},
					"canEdit": {
						"type": "boolean",
						"description": "Whether the contact can be edited (requires resolvable phone number)"
					},
					"avatarUrl": {
						"type": "string",
						"nullable": true,
						"description": "Avatar URL path (our proxy endpoint)"
					}
				},
				"required": [
					"id",
					"phoneNumber",
					"name",
					"pushname",
					"shortName",
					"isMyContact",
					"isBusiness",
					"isBlocked",
					"canEdit",
					"avatarUrl"
				],
				"type": "object",
				"additionalProperties": false
			},
			"SaveContactRequest": {
				"properties": {
